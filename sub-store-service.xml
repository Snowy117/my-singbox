<service>
  <id>sub-store</id>
  <name>Sub-Store</name>
  <description>Local subscription manager for sing-box.</description>

  <workingdirectory>%BASE%\sub-store</workingdirectory>
  <executable>%BASE%\runtime\node.exe</executable>
  <arguments>"%BASE%\sub-store\sub-store.bundle.js"</arguments>
  <env name="SUB_STORE_BACKEND_API_HOST" value="127.0.0.1" />
  <env name="SUB_STORE_BACKEND_API_PORT" value="40008" />
  <env name="SUB_STORE_DATA_BASE_PATH" value="%BASE%\sub-store\data" />
  <env name="SUB_STORE_FRONTEND_HOST" value="127.0.0.1" />
  <env name="SUB_STORE_FRONTEND_PORT" value="40007" />
  <env name="SUB_STORE_FRONTEND_PATH" value="%BASE%\sub-store\frontend" />
  <env name="SUB_STORE_FRONTEND_BACKEND_PATH" value="/" />
  <env name="SUB_STORE_CORS_ALLOWED_ORIGINS" value="http://127.0.0.1:40007,http://localhost:40007" />

  <serviceaccount>
    <localSystem />
  </serviceaccount>

  <logpath>%BASE%\logs</logpath>
  <log mode="roll-by-time">
    <pattern>yyyy-MM-dd</pattern>
    <autoRollAtTime>00:00:00</autoRollAtTime>
    <keepFiles>30</keepFiles>
  </log>
  <onfailure action="restart" delay="10 sec" />
</service>

